# Local PostgreSQL (default)
PG_HOST=localhost
PG_PORT=5432
PG_DB=olist
PG_USER=olist
PG_PASSWORD=olist
PG_SSLMODE=disable

# PostgreSQL schemas
PG_RAW_SCHEMA=olist_raw
PG_PROD_SCHEMA=olist_prod

# Optional Kaggle API token (only if you use scripts/download_data.py)
KAGGLE_API_TOKEN=KGAT_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
